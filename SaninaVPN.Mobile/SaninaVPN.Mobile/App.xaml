<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Hivox.Mobile.Converters"
             x:Class="Hivox.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusColorConverter x:Key="StatusColorConverter"/>
            <converters:ThemeToBoolConverter x:Key="ThemeToBoolConverter"/>
            <converters:PingToColorConverter x:Key="PingToColorConverter"/>
            <converters:PingToBackgroundConverter x:Key="PingToBackground"/>
            <converters:ProtocolToBadgeColorConverter x:Key="ProtocolToBadgeColor"/>
            <converters:ProtocolToBadgeForegroundConverter x:Key="ProtocolToBadgeForeground"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
