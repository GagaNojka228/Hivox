<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Hivox.Mobile.ViewModels"
             x:Class="Hivox.Mobile.Views.ThemePage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{DynamicResource M3SurfaceDim}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="16,16,20,12" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource M3CircleIconBtn}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xE5C4;" FontSize="18" FontFamily="MaterialIcons"
                       TextColor="{DynamicResource M3OnSurfaceVariant}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="Тема оформления" FontSize="20" FontAttributes="Bold"
                   TextColor="{DynamicResource M3OnSurface}" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="0,8,0,24">
                <Label Text="ТЕМА ОФОРМЛЕНИЯ" Style="{StaticResource M3SectionTitle}" Margin="20,4,20,4"/>
                <Border Style="{StaticResource M3SettingsCard}">
                    <VerticalStackLayout Spacing="0">
                        <!-- Dark (Obsidian Violet) -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDarkTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#140D22" Stroke="#7C4DFF" StrokeThickness="2" VerticalOptions="Center">
                                <Ellipse WidthRequest="12" HeightRequest="12" Fill="#B388FF" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Тёмная" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource M3OnSurface}"/>
                                <Label Text="Глубокий фиолетовый обсидиан (Hivox)" FontSize="11" TextColor="{DynamicResource M3OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                            <RadioButton x:Name="DarkRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView Style="{StaticResource M3Divider}"/>

                        <!-- Black (AMOLED) -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBlackTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#000000" Stroke="#7C4DFF" StrokeThickness="2" VerticalOptions="Center">
                                <Ellipse WidthRequest="12" HeightRequest="12" Fill="#FF80E1" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Чёрная" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource M3OnSurface}"/>
                                <Label Text="Чистый чёрный AMOLED-фон с фиолетовым акцентом" FontSize="11" TextColor="{DynamicResource M3OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                            <RadioButton x:Name="BlackRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView Style="{StaticResource M3Divider}"/>

                        <!-- Light -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLightTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#FAF7FF" Stroke="#6750A4" StrokeThickness="2" VerticalOptions="Center">
                                <Ellipse WidthRequest="12" HeightRequest="12" Fill="#6750A4" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Светлая" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource M3OnSurface}"/>
                                <Label Text="Чистая светлая палитра" FontSize="11" TextColor="{DynamicResource M3OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                            <RadioButton x:Name="LightRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalOptions="Center"/>
                        </Grid>

                        <BoxView Style="{StaticResource M3Divider}"/>

                        <!-- Material You (Dynamic Colors) -->
                        <Grid Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMaterialYouTapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="{DynamicResource M3PrimaryContainer}" Stroke="{DynamicResource M3PrimaryBrush}" StrokeThickness="2" VerticalOptions="Center">
                                <Label Text="&#xE40A;" FontFamily="MaterialIcons" FontSize="18"
                                       TextColor="{DynamicResource M3Primary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Material You" FontSize="14.5" FontAttributes="Bold" TextColor="{DynamicResource M3OnSurface}"/>
                                <Label Text="Динамические цвета обоев и системы" FontSize="11" TextColor="{DynamicResource M3OnSurfaceVariant}"/>
                            </VerticalStackLayout>
                            <RadioButton x:Name="MaterialYouRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Сохранить" Style="{StaticResource M3FilledBtn}" Margin="20,4" Clicked="OnSaveClicked"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
