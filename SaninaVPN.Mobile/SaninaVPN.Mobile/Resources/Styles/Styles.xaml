<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page Base Style -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource M3SurfaceDim}"/>
    </Style>

    <!-- Shell -->
    <Style TargetType="Shell">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource M3SurfaceDim}"/>
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource M3Secondary}"/>
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource M3TabBarBg}"/>
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource M3TabActive}"/>
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource M3TabInactive}"/>
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource M3TabActive}"/>
    </Style>

    <!-- M3 Section Title -->
    <Style x:Key="M3SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnSurfaceVariant}"/>
        <Setter Property="Margin" Value="20,18,20,8"/>
    </Style>

    <!-- M3 Card -->
    <Style x:Key="M3Card" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
        <Setter Property="Stroke" Value="{DynamicResource M3OutlineVariantBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource M3SurfaceContainer}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- M3 Settings Group Card -->
    <Style x:Key="M3SettingsCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
        <Setter Property="Stroke" Value="{DynamicResource M3OutlineVariantBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource M3SurfaceContainer}"/>
        <Setter Property="Margin" Value="20,0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- M3 Circle Icon Button -->
    <Style x:Key="M3CircleIconBtn" TargetType="Border">
        <Setter Property="WidthRequest" Value="38"/>
        <Setter Property="HeightRequest" Value="38"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 19"/>
        <Setter Property="Stroke" Value="{DynamicResource M3OutlineVariantBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource M3SurfaceContainerLow}"/>
    </Style>

    <!-- M3 Divider -->
    <Style x:Key="M3Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="Color" Value="{DynamicResource M3OutlineVariant}"/>
        <Setter Property="Opacity" Value="0.5"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

    <!-- M3 Filled Button -->
    <Style x:Key="M3FilledBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource M3Primary}"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnPrimary}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <!-- M3 Tonal Button -->
    <Style x:Key="M3TonalBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource M3SecondaryContainer}"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnSecondaryContainer}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <!-- M3 SearchBar -->
    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource M3Outline}"/>
        <Setter Property="CancelButtonColor" Value="{DynamicResource M3Primary}"/>
    </Style>

    <!-- M3 Switch -->
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource M3Primary}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource M3SwitchThumb}"/>
    </Style>

    <!-- M3 RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnSurface}"/>
        <Setter Property="BorderColor" Value="Transparent"/>
    </Style>

    <!-- M3 CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="Color" Value="{DynamicResource M3Primary}"/>
    </Style>

    <!-- M3 Entry -->
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{DynamicResource M3OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource M3Outline}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="MinimumHeightRequest" Value="38"/>
    </Style>

</ResourceDictionary>
