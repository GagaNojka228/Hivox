<Window x:Class="HivoxInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Hivox"
        Width="560" Height="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0D0817" AllowsTransparency="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FilledBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C4DFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="16" Background="{TemplateBinding Background}" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#936BFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TonalBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A1B3D"/>
            <Setter Property="Foreground" Value="#EADDFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A2856"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#35234E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="M3Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E1F5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Background="#2A1B3D" BorderBrush="#8A7FA8" BorderThickness="1.5" Margin="0,0,10,0">
                                <Path x:Name="chk" Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Width="11" Height="11" Stretch="Uniform" Fill="#FFFFFF" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#7C4DFF"/>
                                <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3A2856" BorderThickness="1" CornerRadius="0" Background="#140D22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#0D0817" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="#2A1B3D" BorderBrush="#7C4DFF" BorderThickness="1" Margin="0,0,8,0">
                            <Viewbox Stretch="Uniform" Margin="2">
                                <Canvas Width="100" Height="100">
                                    <Rectangle Canvas.Left="19" Canvas.Top="15" Width="14" Height="70" RadiusX="7" RadiusY="7" Fill="#EADDFF"/>
                                    <Rectangle Canvas.Left="67" Canvas.Top="15" Width="14" Height="70" RadiusX="7" RadiusY="7" Fill="#B388FF"/>
                                    <Path Data="M26,64 C26,42 74,58 74,36" Stroke="#FF80E1" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="44.5" Canvas.Top="23" Width="11" Height="11" Fill="#EADDFF"/>
                                    <Ellipse Canvas.Left="44.5" Canvas.Top="66" Width="11" Height="11" Fill="#B388FF"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="WindowHeaderTitle" Text="Установка Hivox" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6E1F5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click" FocusVisualStyle="{x:Null}">
                        <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" Width="10" Height="10" Stretch="Uniform" Fill="#B9B0D8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="62" Height="62" CornerRadius="18" BorderThickness="1.5" Margin="0,0,16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A1B3D" Offset="0"/>
                                <GradientStop Color="#140D22" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9D78FF" Offset="0"/>
                                <GradientStop Color="#7C4DFF" Offset="0.6"/>
                                <GradientStop Color="#4B2B85" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Viewbox Stretch="Uniform" Margin="2">
                            <Canvas Width="100" Height="100">
                                <Rectangle Canvas.Left="19" Canvas.Top="15" Width="14" Height="70" RadiusX="7" RadiusY="7">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#EADDFF" Offset="0"/>
                                            <GradientStop Color="#7C4DFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Canvas.Left="67" Canvas.Top="15" Width="14" Height="70" RadiusX="7" RadiusY="7">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#B388FF" Offset="0"/>
                                            <GradientStop Color="#FF80E1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Path Data="M26,64 C26,42 74,58 74,36" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#7C4DFF" Offset="0"/>
                                            <GradientStop Color="#B388FF" Offset="0.5"/>
                                            <GradientStop Color="#FF80E1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>
                                <Ellipse Canvas.Left="44.5" Canvas.Top="23" Width="11" Height="11" Fill="#EADDFF"/>
                                <Ellipse Canvas.Left="44.5" Canvas.Top="66" Width="11" Height="11" Fill="#B388FF"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" Text="Hivox v2.1.1" FontSize="22" FontWeight="Bold" Foreground="#E6E1F5"/>
                        <TextBlock x:Name="HeroSubtitle" Text="Secure Connection. Limitless Freedom." FontSize="12.5" Foreground="#B9B0D8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Install Options Card -->
                <Border x:Name="InstallPanel" Grid.Row="1" CornerRadius="18" Background="#1A102A" BorderBrush="#3A2856" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="10.5" FontWeight="Bold" Foreground="#B388FF" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="12" Background="#2A1B3D" BorderBrush="#3A2856" BorderThickness="1" Padding="10,7">
                                <TextBox x:Name="InstallPathBox" Background="Transparent" BorderThickness="0" Foreground="#E6E1F5" CaretBrush="#7C4DFF" FontSize="12.5" VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Content="Обзор..." Style="{StaticResource TonalBtn}" Click="Browse_Click"/>
                        </Grid>

                        <CheckBox x:Name="DesktopShortcutCheck" Content="Создать ярлык на рабочем столе" Style="{StaticResource M3Check}" IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="StartMenuShortcutCheck" Content="Добавить ярлык в меню «Пуск»" Style="{StaticResource M3Check}" IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="LaunchAfterCheck" Content="Запустить Hivox после установки" Style="{StaticResource M3Check}" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <!-- Progress / Uninstall Panel -->
                <Border x:Name="ProgressPanel" Grid.Row="1" CornerRadius="18" Background="#1A102A" BorderBrush="#3A2856" BorderThickness="1" Padding="20" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressStatusText" Text="Подготовка файлов..." FontSize="14" FontWeight="SemiBold" Foreground="#E6E1F5" Margin="0,0,0,10"/>
                        <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Background="#2A1B3D" Foreground="#7C4DFF" BorderThickness="0"/>
                        <TextBlock x:Name="ProgressDetailText" Text="Xray-core и Sing-box встроены" FontSize="11.5" Foreground="#B9B0D8" Margin="0,8,0,0"/>
                        <CheckBox x:Name="RemoveUserDataCheck" Content="Удалить сохранённые подписки и настройки (%AppData%\Hivox)" Style="{StaticResource M3Check}" Margin="0,16,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Button x:Name="PrimaryActionBtn" Content="Установить Hivox" Style="{StaticResource FilledBtn}" HorizontalAlignment="Right" Click="PrimaryAction_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
