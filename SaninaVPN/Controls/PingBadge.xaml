<UserControl x:Class="Hivox.Controls.PingBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Signal Bars (Шкала / Оба) -->
        <StackPanel x:Name="BarsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Border x:Name="Bar1" Width="3" Height="5" CornerRadius="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
            <Border x:Name="Bar2" Width="3" Height="8" CornerRadius="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
            <Border x:Name="Bar3" Width="3" Height="11" CornerRadius="1.5" Margin="0,0,2,0" VerticalAlignment="Bottom"/>
            <Border x:Name="Bar4" Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Signal Dots (Точки) -->
        <StackPanel x:Name="DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse x:Name="Dot1" Width="5.5" Height="5.5" Margin="0,0,3,0"/>
            <Ellipse x:Name="Dot2" Width="5.5" Height="5.5" Margin="0,0,3,0"/>
            <Ellipse x:Name="Dot3" Width="5.5" Height="5.5" Margin="0,0,3,0"/>
            <Ellipse x:Name="Dot4" Width="5.5" Height="5.5"/>
        </StackPanel>

        <!-- Numeric Label (Цифры / Оба / N/A) -->
        <TextBlock x:Name="PingText" Text="—" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
