<UserControl x:Class="Hivox.Controls.M3SettingsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="52">
    <Border x:Name="RowBorder" MouseLeftButtonDown="OnClick" Padding="12,9" Margin="4,3" CornerRadius="16">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBadge" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                    Background="{DynamicResource M3SurfaceContainerHighBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                    Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Path x:Name="IconPath" Width="15" Height="15" Stretch="Uniform"
                      Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="LabelElement" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                <TextBlock x:Name="SubtitleElement" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Visibility="Collapsed" Margin="0,1,0,0"/>
            </StackPanel>

            <ContentControl Grid.Column="2" x:Name="ValueElement" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
