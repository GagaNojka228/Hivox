<UserControl x:Class="Hivox.Views.CoreTypePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Text="ЯДРО МАРШРУТИЗАЦИИ" Style="{StaticResource M3SectionTitle}"/>
        <Border Style="{StaticResource M3SettingsSection}">
            <StackPanel>
                <Grid MinHeight="64" Cursor="Hand" MouseLeftButtonDown="Xray_Click" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="16,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCpu}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,12,10">
                        <TextBlock Text="Xray-core" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="VLESS, Reality, XHTTP, VMess, Trojan, Shadowsocks (режимы Proxy и TUN)" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <RadioButton x:Name="XrayRadio" Grid.Column="2" GroupName="CoreType" VerticalAlignment="Center" IsChecked="True" Margin="0,0,14,0"/>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="16,0" Opacity="0.5"/>

                <Grid MinHeight="64" Cursor="Hand" MouseLeftButtonDown="Singbox_Click" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="16,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBolt}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,12,10">
                        <TextBlock Text="Sing-box" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="Hysteria2, TUIC, VLESS, VMess, Trojan и поддержка TUN-режима" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <RadioButton x:Name="SingboxRadio" Grid.Column="2" GroupName="CoreType" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border CornerRadius="14" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="14,10" Margin="12,14,12,0">
            <TextBlock Text="Оба ядра поддерживают как режим Proxy, так и режим TUN. Переключение режима на главном экране больше не меняет выбранное ядро." FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
        </Border>

        <Button Style="{StaticResource M3FilledBtn}" Width="168" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSave}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Сохранить"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
