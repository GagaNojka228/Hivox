<UserControl x:Class="Hivox.Views.SubscriptionEditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hivox.Controls">
    <ScrollViewer Style="{StaticResource M3ScrollViewer}">
        <StackPanel Margin="0,0,0,28">
            <!-- Название -->
            <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="14,12">
                <Border CornerRadius="12" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="12,8">
                    <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource M3OnSurfaceBrush}" CaretBrush="{DynamicResource M3PrimaryBrush}"
                             FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Border>

            <!-- Видимость -->
            <TextBlock Text="ВИДИМОСТЬ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <local:M3SettingsRow x:Name="NeverCollapseRow"
                                     Label="Не сворачивать"
                                     Subtitle="Список серверов остаётся раскрытым даже при сворачивании всех подписок"
                                     IconData="{StaticResource IconEye}"
                                     IsToggle="True"/>
            </Border>

            <!-- Ссылки (hidden if none) -->
            <StackPanel x:Name="LinksSection" Visibility="Collapsed">
                <TextBlock Text="ССЫЛКИ" Style="{StaticResource M3SectionTitle}"/>
                <Border Style="{StaticResource M3SettingsSection}">
                    <StackPanel>
                        <local:M3SettingsRow x:Name="SupportLinkRow" Label="Поддержка" Subtitle="Открыть страницу поддержки провайдера"
                                             IconData="{StaticResource IconInfo}" IsLink="True" Visibility="Collapsed"/>
                        <Rectangle x:Name="LinksDivider" Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5" Visibility="Collapsed"/>
                        <local:M3SettingsRow x:Name="WebLinkRow" Label="Сайт" Subtitle="Открыть личный кабинет или сайт"
                                             IconData="{StaticResource IconGlobe}" IsLink="True" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Интервал обновления -->
            <TextBlock Text="ИНТЕРВАЛ ОБНОВЛЕНИЯ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <StackPanel>
                    <local:M3SettingsRow x:Name="CustomIntervalRow"
                                         Label="Свой интервал"
                                         Subtitle="Иначе используется общий интервал из настроек"
                                         IconData="{StaticResource IconClock}"
                                         IsToggle="True"/>
                    <StackPanel x:Name="IntervalChipsPanel" Margin="14,4,14,14" Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="Int30mRadio" Grid.Column="0" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="30 мин"/>
                            <RadioButton x:Name="Int1hRadio" Grid.Column="2" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="1 час"/>
                            <RadioButton x:Name="Int2hRadio" Grid.Column="4" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="2 часа"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="Int6hRadio" Grid.Column="0" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="6 часов"/>
                            <RadioButton x:Name="Int12hRadio" Grid.Column="2" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="12 часов"/>
                            <RadioButton x:Name="Int24hRadio" Grid.Column="4" GroupName="SubInterval" Style="{StaticResource M3SegmentedBtn}" Content="24 часа"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Пинг и отображение -->
            <TextBlock Text="ПИНГ И ОТОБРАЖЕНИЕ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Способ отображения" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="2,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="DispTimeRadio" Grid.Column="0" GroupName="SubPingDisp" Style="{StaticResource M3SegmentedBtn}" Content="Цифры"/>
                        <RadioButton x:Name="DispBarsRadio" Grid.Column="2" GroupName="SubPingDisp" Style="{StaticResource M3SegmentedBtn}" Content="Шкала"/>
                        <RadioButton x:Name="DispBothRadio" Grid.Column="4" GroupName="SubPingDisp" Style="{StaticResource M3SegmentedBtn}" Content="Оба"/>
                        <RadioButton x:Name="DispDotsRadio" Grid.Column="6" GroupName="SubPingDisp" Style="{StaticResource M3SegmentedBtn}" Content="Точки"/>
                    </Grid>

                    <TextBlock Text="Протокол пинга" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="2,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ProtoProxyRadio" Grid.Column="0" GroupName="SubPingProto" Style="{StaticResource M3SegmentedBtn}" Content="Real Ping"/>
                        <RadioButton x:Name="ProtoTcpRadio" Grid.Column="2" GroupName="SubPingProto" Style="{StaticResource M3SegmentedBtn}" Content="TCP"/>
                        <RadioButton x:Name="ProtoGetRadio" Grid.Column="4" GroupName="SubPingProto" Style="{StaticResource M3SegmentedBtn}" Content="HTTP GET"/>
                        <RadioButton x:Name="ProtoHeadRadio" Grid.Column="6" GroupName="SubPingProto" Style="{StaticResource M3SegmentedBtn}" Content="HTTP HEAD"/>
                    </Grid>

                    <TextBlock Text="Протокол пинга URL" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="2,0,0,6"/>
                    <Border CornerRadius="12" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="12,8">
                        <TextBox x:Name="PingUrlBox" Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{DynamicResource M3OnSurfaceBrush}" CaretBrush="{DynamicResource M3PrimaryBrush}"
                                 FontSize="12.5"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Сортировка серверов -->
            <TextBlock Text="СПИСОК СЕРВЕРОВ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="SortDefaultRadio" Grid.Column="0" GroupName="SubSort" Style="{StaticResource M3SegmentedBtn}" Content="По умолчанию"/>
                    <RadioButton x:Name="SortPingRadio" Grid.Column="2" GroupName="SubSort" Style="{StaticResource M3SegmentedBtn}" Content="По пингу"/>
                    <RadioButton x:Name="SortAlphaRadio" Grid.Column="4" GroupName="SubSort" Style="{StaticResource M3SegmentedBtn}" Content="По имени"/>
                </Grid>
            </Border>

            <!-- DNS туннеля -->
            <TextBlock Text="DNS ТУННЕЛЯ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="14,12">
                <StackPanel>
                    <Border CornerRadius="12" Background="{DynamicResource M3SurfaceContainerHighBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <TextBlock x:Name="DnsPlaceholder" Text="Например: 1.1.1.1 или https://dns.google/dns-query"
                                       FontSize="12" Foreground="{DynamicResource M3OutlineBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="CustomDnsBox" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource M3OnSurfaceBrush}" CaretBrush="{DynamicResource M3PrimaryBrush}"
                                     FontSize="12.5" TextChanged="CustomDnsBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Оставьте пустым, чтобы использовать глобальную настройку DNS."
                               FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,6,4,0"/>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource M3FilledBtn}" Width="190" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
