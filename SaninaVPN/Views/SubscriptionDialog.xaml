<Window x:Class="Hivox.Views.SubscriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписки" Height="490" Width="540" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource M3SurfaceDimBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource M3PrimaryContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,12,0">
                <Path Data="{StaticResource IconRss}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Подписки" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                <TextBlock Text="Вставьте ссылку — серверы и тариф загрузятся автоматически" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Inline Add Subscription Box -->
        <Border Grid.Row="1" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBox x:Name="UrlTextBox" FontSize="12.5" Height="38" VerticalContentAlignment="Center" Padding="12,0"
                             TextChanged="UrlTextBox_TextChanged" KeyDown="UrlTextBox_KeyDown"/>
                    <TextBlock x:Name="UrlPlaceholder" Text="https://example.com/sub/..." FontSize="12"
                               Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" Margin="14,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <Button x:Name="PasteBtn" Grid.Column="1" Style="{StaticResource M3TonalBtn}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="Paste_Click" ToolTip="Вставить из буфера обмена">
                    <TextBlock Text="Вставить" FontSize="12"/>
                </Button>

                <Button x:Name="AddBtn" Grid.Column="2" Style="{StaticResource M3FilledBtn}" Height="38" Padding="16,0" Click="AddSubscription_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAdd}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Inline Status Banner -->
        <TextBlock x:Name="StatusBanner" Grid.Row="2" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,0,4,10"
                   Visibility="Collapsed" TextWrapping="Wrap"/>

        <!-- Saved Subscriptions List -->
        <ListBox x:Name="SubscriptionListBox" Grid.Row="3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconGlobe}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Action Row -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RefreshAllBtn" Style="{StaticResource M3TonalBtn}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="UpdateSubscriptions_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить все"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource M3TonalBtn}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="CopySubscription_Click" ToolTip="Копировать выбранную ссылку">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCopy}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                        <TextBlock Text="Копировать"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource M3TonalBtn}" Height="38" Padding="14,0" Foreground="{DynamicResource M3RedBrush}" Click="DeleteSubscription_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource M3RedBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Style="{StaticResource M3TonalBtn}" Content="Готово" Height="38" Padding="18,0" HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
