<UserControl x:Class="Hivox.Views.PingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource M3ScrollViewer}">
        <StackPanel Margin="0,0,0,28">
            <!-- Section 1: Ping Protocol -->
            <TextBlock Text="ПРОТОКОЛ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ProtoProxyRadio" Grid.Column="0" GroupName="PingProtocol" Style="{StaticResource M3SegmentedBtn}" Content="Real Ping" ToolTip="Реальная задержка через прокси-туннель к тестовому URL"/>
                        <RadioButton x:Name="ProtoTcpRadio" Grid.Column="2" GroupName="PingProtocol" Style="{StaticResource M3SegmentedBtn}" Content="TCP" ToolTip="Прямой TCP handshake к хосту и порту"/>
                        <RadioButton x:Name="ProtoGetRadio" Grid.Column="4" GroupName="PingProtocol" Style="{StaticResource M3SegmentedBtn}" Content="HTTP GET" ToolTip="Полный HTTP GET-запрос через узел"/>
                        <RadioButton x:Name="ProtoHeadRadio" Grid.Column="6" GroupName="PingProtocol" Style="{StaticResource M3SegmentedBtn}" Content="HTTP HEAD" ToolTip="Быстрый HTTP HEAD-запрос через узел"/>
                    </Grid>
                    <TextBlock x:Name="ProtocolHintText" Text="Real Ping измеряет реальную задержку через VPN-туннель и не подвержен ложным 1 ms при активном TUN"
                               FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="6,8,6,2" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Section 2: Display Format -->
            <TextBlock Text="ОТОБРАЖЕНИЕ ПИНГА" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DispTimeRadio" Grid.Column="0" GroupName="PingDisplay" Style="{StaticResource M3SegmentedBtn}" Content="Цифры"/>
                    <RadioButton x:Name="DispBarsRadio" Grid.Column="2" GroupName="PingDisplay" Style="{StaticResource M3SegmentedBtn}" Content="Шкала"/>
                    <RadioButton x:Name="DispBothRadio" Grid.Column="4" GroupName="PingDisplay" Style="{StaticResource M3SegmentedBtn}" Content="Оба"/>
                    <RadioButton x:Name="DispDotsRadio" Grid.Column="6" GroupName="PingDisplay" Style="{StaticResource M3SegmentedBtn}" Content="Точки"/>
                </Grid>
            </Border>

            <!-- Section 3: Test URL & Presets -->
            <TextBlock Text="ТЕСТОВЫЙ URL" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="14,12">
                <StackPanel>
                    <Border CornerRadius="14" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="12,8">
                        <TextBox x:Name="TestUrlBox"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{DynamicResource M3OnSurfaceBrush}"
                                 CaretBrush="{DynamicResource M3PrimaryBrush}"
                                 FontSize="12.5" FontWeight="Medium"
                                 TextChanged="TestUrlBox_TextChanged"/>
                    </Border>

                    <TextBlock Text="Пресеты" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="4,12,0,6"/>

                    <!-- Google 204 -->
                    <Border x:Name="PresetGoogleCard" CornerRadius="12" Padding="12,9" Cursor="Hand" MouseLeftButtonDown="PresetGoogle_Click" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PresetGoogleTitle" Text="Google 204" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock Text="https://www.gstatic.com/generate_204" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <Path x:Name="PresetGoogleCheck" Grid.Column="1" Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Cloudflare -->
                    <Border x:Name="PresetCloudflareCard" CornerRadius="12" Padding="12,9" Cursor="Hand" MouseLeftButtonDown="PresetCloudflare_Click" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PresetCloudflareTitle" Text="Cloudflare" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock Text="https://cp.cloudflare.com/generate_204" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <Path x:Name="PresetCloudflareCheck" Grid.Column="1" Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Apple -->
                    <Border x:Name="PresetAppleCard" CornerRadius="12" Padding="12,9" Cursor="Hand" MouseLeftButtonDown="PresetApple_Click" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PresetAppleTitle" Text="Apple" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                <TextBlock Text="http://captive.apple.com/hotspot-detect.html" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                            </StackPanel>
                            <Path x:Name="PresetAppleCheck" Grid.Column="1" Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Section 4: Timeout Stepper -->
            <TextBlock Text="ТАЙМ-АУТ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Тайм-аут пинга" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="Максимальное время ожидания ответа" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="32" Height="32" Style="{StaticResource M3CircleIconBtn}" Click="TimeoutMinus_Click" ToolTip="Уменьшить">
                            <TextBlock Text="−" FontSize="15" FontWeight="Bold" Margin="0,-2,0,0"/>
                        </Button>
                        <Border CornerRadius="10" Background="{DynamicResource M3PrimaryContainerBrush}" Padding="12,6" Margin="8,0" MinWidth="46">
                            <TextBlock x:Name="TimeoutValueText" Text="3s" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Width="32" Height="32" Style="{StaticResource M3CircleIconBtn}" Click="TimeoutPlus_Click" ToolTip="Увеличить">
                            <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-2,0,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Style="{StaticResource M3FilledBtn}" Width="176" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
