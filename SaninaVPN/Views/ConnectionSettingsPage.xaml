<UserControl x:Class="Hivox.Views.ConnectionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hivox.Controls">
    <ScrollViewer Style="{StaticResource M3ScrollViewer}">
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="ЗАПУСК И АВТОМАТИЗАЦИЯ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <StackPanel>
                    <local:M3SettingsRow x:Name="ConnectOnOpenRow" Label="Автоподключение" Subtitle="Подключаться к лучшему узлу при запуске Hivox" IconData="{StaticResource IconBolt}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="AutoStartRow" Label="Автозапуск с Windows" Subtitle="Запускать Hivox автоматически при входе в систему" IconData="{StaticResource IconPlay}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="AutoBestRow" Label="Автовыбор лучшего узла" Subtitle="Автоматически выбирать сервер с минимальным пингом" IconData="{StaticResource IconSpeed}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="AutoReconnectRow" Label="Защита соединения (Watchdog)" Subtitle="Контролировать туннель и переподключать при сбое" IconData="{StaticResource IconShield}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="DisconnectOnLockRow" Label="Отключать при блокировке ПК" Subtitle="Разрывать VPN-соединение при блокировке экрана (Win+L)" IconData="{StaticResource IconLock}" IsToggle="True"/>
                </StackPanel>
            </Border>

            <TextBlock Text="МАРШРУТИЗАЦИЯ И ЛОКАЛЬНАЯ СЕТЬ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <StackPanel>
                    <local:M3SettingsRow x:Name="BypassLanRow" Label="Исключать локальную сеть (Bypass LAN)" Subtitle="Направлять роутер, принтеры и NAS (192.168.x.x / 10.x) мимо VPN" IconData="{StaticResource IconRouter}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="BypassRuRow" Label="Обход доменов РФ напрямую" Subtitle="Направлять российские банки, Госуслуги и маркетплейсы мимо VPN" IconData="{StaticResource IconGlobe}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <local:M3SettingsRow x:Name="AllowLanRow" Label="Подключения из LAN" Subtitle="Разрешить устройствам в локальной сети подключаться к прокси (0.0.0.0)" IconData="{StaticResource IconDns}" IsToggle="True"/>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource M3FilledBtn}" Width="176" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
