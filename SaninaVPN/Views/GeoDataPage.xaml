<UserControl x:Class="Hivox.Views.GeoDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hivox.Controls">
    <ScrollViewer Style="{StaticResource M3ScrollViewer}">
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="ЛОКАЛЬНЫЕ ФАЙЛЫ МАРШРУТИЗАЦИИ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGlobe}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="geoip.dat" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                            <TextBlock x:Name="GeoIpShaText" Text="SHA-256: —" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="GeoIpSizeText" Grid.Column="2" Text="Встроенная" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="46,0,0,12" Opacity="0.5"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDns}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="geosite.dat" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                            <TextBlock x:Name="GeoSiteShaText" Text="SHA-256: —" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="GeoSiteSizeText" Grid.Column="2" Text="Встроенная" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="LastUpdatedText" Text="Последнее обновление: встроенная база" FontSize="11.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="2,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="РАСПИСАНИЕ ОБНОВЛЕНИЯ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <StackPanel>
                    <local:M3SettingsRow x:Name="GeoAutoRow" Label="Автообновление" Subtitle="Проверять и обновлять Geo-базы по расписанию" IconData="{StaticResource IconRefresh}" IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <StackPanel Margin="16,12">
                        <TextBlock Text="Интервал проверки" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="Int3Radio" Grid.Column="0" GroupName="GeoInterval" Style="{StaticResource M3SegmentedBtn}" Content="3 дн."/>
                            <RadioButton x:Name="Int7Radio" Grid.Column="2" GroupName="GeoInterval" Style="{StaticResource M3SegmentedBtn}" Content="7 дн."/>
                            <RadioButton x:Name="Int14Radio" Grid.Column="4" GroupName="GeoInterval" Style="{StaticResource M3SegmentedBtn}" Content="14 дн."/>
                            <RadioButton x:Name="Int30Radio" Grid.Column="6" GroupName="GeoInterval" Style="{StaticResource M3SegmentedBtn}" Content="30 дн."/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="14" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="14,10" Margin="12,14,12,0">
                <TextBlock Text="Перед заменой файлов проверяется эталонная контрольная сумма SHA-256 с официального репозитория v2ray-rules-dat. Повреждённые файлы отклоняются." FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="UpdateNowBtn" Style="{StaticResource M3FilledBtn}" Height="42" Padding="20,0" Margin="0,0,10,0" Click="UpdateNow_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                        <TextBlock Text="Обновить базы (SHA-256)"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource M3TonalBtn}" Height="42" Padding="18,0" Click="Save_Click" Content="Сохранить"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
