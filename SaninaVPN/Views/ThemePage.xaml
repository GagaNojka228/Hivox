<UserControl x:Class="Hivox.Views.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,24">
        <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ" Style="{StaticResource M3SectionTitle}"/>
        <Border Style="{StaticResource M3SettingsSection}">
            <StackPanel>
                <!-- Dark Theme (Obsidian Violet) -->
                <Grid MinHeight="64" Cursor="Hand" MouseLeftButtonDown="Dark_Click" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#140D22" BorderBrush="#7C4DFF" BorderThickness="2" Margin="16,0,12,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#B388FF"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,12,10">
                        <TextBlock Text="Тёмная" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="Глубокий фиолетовый обсидиан (Hivox)" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                    </StackPanel>
                    <RadioButton x:Name="DarkRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="16,0" Opacity="0.5"/>

                <!-- Black Theme (AMOLED Pure Black) -->
                <Grid MinHeight="64" Cursor="Hand" MouseLeftButtonDown="Black_Click" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#000000" BorderBrush="#7C4DFF" BorderThickness="2" Margin="16,0,12,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FF80E1"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,12,10">
                        <TextBlock Text="Чёрная" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="Чистый чёрный AMOLED-фон с фиолетовым акцентом" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                    </StackPanel>
                    <RadioButton x:Name="BlackRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="16,0" Opacity="0.5"/>

                <!-- Light Theme -->
                <Grid MinHeight="64" Cursor="Hand" MouseLeftButtonDown="Light_Click" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#FAF7FF" BorderBrush="#6750A4" BorderThickness="2" Margin="16,0,12,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#6750A4"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,12,10">
                        <TextBlock Text="Светлая" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                        <TextBlock Text="Чистая светлая палитра Material 3" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                    </StackPanel>
                    <RadioButton x:Name="LightRadio" Grid.Column="2" GroupName="AppThemeGroup" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button Style="{StaticResource M3FilledBtn}" Width="168" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSave}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                <TextBlock Text="Сохранить"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
