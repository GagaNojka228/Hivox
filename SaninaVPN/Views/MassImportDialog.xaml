<Window x:Class="Hivox.Views.MassImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Массовый импорт" Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource M3SurfaceDimBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource M3PrimaryContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,10,0">
                <Path Data="{StaticResource IconImport}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Массовый импорт" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                <TextBlock Text="Вставьте ссылки (vless://, vmess://, trojan://, hy2://), base64 или URL подписки" FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="14">
            <TextBox x:Name="ImportTextBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" Padding="0" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
        </Border>

        <TextBlock x:Name="ResultLabel" Grid.Row="2" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,8,0,4"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource M3TonalBtn}" Content="Закрыть" Width="105" Height="38" Margin="0,0,8,0" Click="Close_Click"/>
            <Button Style="{StaticResource M3FilledBtn}" Height="38" Padding="18,0" Click="DoImport_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconImport}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,7,0"/>
                    <TextBlock Text="Импортировать"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
