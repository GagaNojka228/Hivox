<UserControl x:Class="Hivox.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Hivox.Controls">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" MaxWidth="460">
        <controls:BrandLogo Width="80" Height="80" CornerRadiusSize="22" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="Hivox" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Secure Connection. Limitless Freedom." FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <Border CornerRadius="10" Background="{DynamicResource M3PrimaryContainerBrush}" Padding="10,4" HorizontalAlignment="Center" Margin="0,10,0,20">
            <TextBlock Text="{Binding AppVersionLabel, FallbackValue=Версия 2.1.1}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3SecondaryBrush}"/>
        </Border>

        <Border Style="{StaticResource M3SettingsSection}" Margin="0,0,0,14" Padding="20">
            <StackPanel>
                <TextBlock Text="ТЕХНОЛОГИИ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource M3PrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Ядра маршрутизации: Xray-core &amp; Sing-box" FontSize="13" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="Протоколы: VLESS, VMess, Trojan, Shadowsocks, Hysteria2, TUIC" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="Режимы работы: Системный Proxy и TUN (виртуальный адаптер)" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Text="© 2024–2026 Hivox" FontSize="11.5" Foreground="{DynamicResource M3OutlineBrush}" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
