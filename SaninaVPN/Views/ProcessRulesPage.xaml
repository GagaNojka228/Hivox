<UserControl x:Class="Hivox.Views.ProcessRulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hivox.Controls">
    <ScrollViewer Style="{StaticResource M3ScrollViewer}">
        <StackPanel Margin="0,0,0,28">
            <!-- Info Banner -->
            <Border CornerRadius="16"
                    Background="{DynamicResource M3PrimaryContainerBrush}"
                    BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                    BorderThickness="1"
                    Margin="12,12,12,4"
                    Padding="14,11">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}" Width="15" Height="15" Stretch="Uniform"
                          Fill="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Text="Правила по процессам работают в режиме TUN (поддерживаются ядра Xray и Sing-box). В режиме Proxy весь трафик зависит от системного прокси."
                               FontSize="11.5" Foreground="{DynamicResource M3OnPrimaryContainerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Enable & Mode -->
            <TextBlock Text="РЕЖИМ МАРШРУТИЗАЦИИ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}">
                <StackPanel>
                    <local:M3SettingsRow x:Name="EnableRulesRow"
                                         Label="Включить правила по процессам"
                                         Subtitle="Выборочная маршрутизация приложений Windows"
                                         IconData="{StaticResource IconApps}"
                                         IsToggle="True"/>
                    <Rectangle Height="1" Fill="{DynamicResource M3OutlineVariantBrush}" Margin="58,0,16,0" Opacity="0.5"/>
                    <StackPanel Margin="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="ModeBypassRadio" Grid.Column="0" GroupName="ProcessMode"
                                         Style="{StaticResource M3SegmentedBtn}" Content="Напрямую (исключить)"
                                         Checked="ModeRadio_Checked"/>
                            <RadioButton x:Name="ModeOnlyVpnRadio" Grid.Column="2" GroupName="ProcessMode"
                                         Style="{StaticResource M3SegmentedBtn}" Content="Только через VPN"
                                         Checked="ModeRadio_Checked"/>
                        </Grid>
                        <TextBlock x:Name="ModeHintText"
                                   Text="Выбранные программы идут напрямую в обход VPN, весь остальной трафик — через VPN."
                                   FontSize="11" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   Margin="4,8,4,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Add Process -->
            <TextBlock Text="ДОБАВИТЬ ПРОГРАММУ" Style="{StaticResource M3SectionTitle}"/>
            <Border Style="{StaticResource M3SettingsSection}" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="12"
                                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                BorderThickness="1" Padding="12,7">
                            <Grid>
                                <TextBlock x:Name="ProcessPlaceholder" Text="Например: discord.exe"
                                           FontSize="12.5" Foreground="{DynamicResource M3OutlineBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="ProcessInputBox" Background="Transparent" BorderThickness="0" Padding="0"
                                         Foreground="{DynamicResource M3OnSurfaceBrush}" CaretBrush="{DynamicResource M3PrimaryBrush}"
                                         FontSize="12.5" TextChanged="ProcessInputBox_TextChanged" KeyDown="ProcessInputBox_KeyDown"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource M3FilledBtn}" Height="36" Padding="16,0" Click="AddManual_Click">
                            <TextBlock Text="+ Добавить" FontSize="12"/>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource M3TonalBtn}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BrowseExe_Click">
                            <TextBlock Text="Обзор .exe" FontSize="11.5"/>
                        </Button>
                        <Button x:Name="ToggleRunningBtn" Style="{StaticResource M3TonalBtn}" Height="32" Padding="12,0" Click="ToggleRunning_Click">
                            <TextBlock Text="Выбрать из запущенных" FontSize="11.5"/>
                        </Button>
                    </StackPanel>

                    <!-- Running Processes Picker (collapsible) -->
                    <Border x:Name="RunningAppsPanel" Visibility="Collapsed" Margin="0,10,0,0"
                            CornerRadius="14" Background="{DynamicResource M3SurfaceContainerLowBrush}"
                            BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <Grid Margin="2,0,2,8">
                                <TextBlock Text="Запущенные приложения (нажмите, чтобы добавить)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource M3CircleIconBtn}" Width="24" Height="24"
                                        Click="RefreshRunning_Click" ToolTip="Обновить список">
                                    <Path Data="{StaticResource IconRefresh}" Width="11" Height="11" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                            <WrapPanel x:Name="RunningAppsWrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Быстрые пресеты" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="2,12,0,6"/>
                    <WrapPanel x:Name="PresetsWrap"/>
                </StackPanel>
            </Border>

            <!-- Active Process List -->
            <Grid Margin="18,16,16,8">
                <TextBlock x:Name="ListTitleText" Text="СПИСОК ПРОЦЕССОВ (0)" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource M3PrimaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="ClearAllBtn" HorizontalAlignment="Right" Style="{StaticResource M3TonalBtn}" Height="26" Padding="10,0"
                        Click="ClearAll_Click" Visibility="Collapsed">
                    <TextBlock Text="Очистить" FontSize="11"/>
                </Button>
            </Grid>
            <Border Style="{StaticResource M3SettingsSection}" Padding="10,8">
                <StackPanel>
                    <TextBlock x:Name="EmptyListText"
                               Text="Список пуст. Добавьте имя процесса (например, discord.exe) или выберите из запущенных программ."
                               FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                               Margin="8,10" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ProcessListPanel"/>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource M3FilledBtn}" Width="176" Height="42" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Width="15" Height="15" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
