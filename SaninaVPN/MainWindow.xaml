<Window x:Class="Hivox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hivox.Controls"
        xmlns:vm="clr-namespace:Hivox.ViewModels"
        Title="Hivox"
        Height="780" Width="1140" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource M3SurfaceDimBrush}"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom M3 Expressive Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource M3SurfaceDimBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid Margin="18,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:BrandLogo Width="28" Height="28" CornerRadiusSize="9" Margin="0,0,10,0"/>
                    <TextBlock Text="Hivox" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Background="{DynamicResource M3PrimaryContainerBrush}" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersionText, FallbackValue=v2.1.0}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3SecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource M3TitleBarBtn}" Click="Minimize_Click" ToolTip="Свернуть" Margin="0,0,4,0">
                        <Path Data="{StaticResource IconMinimize}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource M3TitleBarBtn}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid Margin="18,4,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410" MinWidth="370"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: Expressive Connection Hub -->
                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="28" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Header: Status Pill + Quick Action Icons -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="16" Padding="12,7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource M3GreenContainerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource M3RedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource M3AmberBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource M3GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleGameModeCommand}" ToolTip="Игровой режим (меньше логирования и задержек)" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource M3CircleIconBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GameMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource M3PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource IconGamepad}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>

                                <Button Style="{StaticResource M3CircleIconBtn}" Command="{Binding ToggleThemeCommand}" ToolTip="Переключить тему" Margin="0,0,6,0">
                                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconMoon}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconSun}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <Button Style="{StaticResource M3CircleIconBtn}" Click="ShowSettings_Click" ToolTip="Настройки">
                                    <Path Data="{StaticResource IconSettings}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Active Server Card -->
                        <Border Grid.Row="1" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="32" CornerRadius="10" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ActiveFlagImage" Source="{Binding SelectedServer.CountryBadge, Converter={StaticResource CountryFlag}}" Width="34" Height="22" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedServer.CountryBadge}" Value="GL">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path Data="{StaticResource IconShield}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedServer.CountryBadge}" Value="GL">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source, ElementName=ActiveFlagImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Текущий профиль" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock Text="{Binding ServerLabel}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Background="{Binding SelectedServer.Ping, Converter={StaticResource PingToBackground}}" Padding="9,5" VerticalAlignment="Center" Visibility="{Binding SelectedServer, Converter={StaticResource StringNotEmptyToVisibility}}">
                                    <controls:PingBadge PingValue="{Binding SelectedServer.Ping, FallbackValue=-1}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Hero Expressive Power Button + Telemetry -->
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Outer Luminous Halo + Morphing Button -->
                                <Grid Width="174" Height="174" HorizontalAlignment="Center">
                                    <!-- Ambient Glow Ring -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="87"/>
                                                <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerLowBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryContainerBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#7C4DFF" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="CornerRadius" Value="52"/>
                                                        <Setter Property="Background" Value="{DynamicResource M3GreenContainerBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource M3GreenBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#4ADE80" BlurRadius="30" ShadowDepth="0" Opacity="0.45"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                        <Setter Property="CornerRadius" Value="62"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource M3SecondaryBrush}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#B388FF" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Command="{Binding ToggleConnectionCommand}" Width="140" Height="140" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="heroBtn">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="70"/>
                                                            <Setter Property="Background" Value="{DynamicResource M3SurfaceContainerHighBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2.5"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#7C4DFF" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                    <Setter Property="CornerRadius" Value="42"/>
                                                                    <Setter Property="Background" Value="{DynamicResource M3GreenBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#4ADE80" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                    <Setter Property="CornerRadius" Value="48"/>
                                                                    <Setter Property="Background" Value="{DynamicResource M3PrimaryContainerBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource M3TertiaryBrush}"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.93"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource IconPower}" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="{DynamicResource M3OnSurfaceBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource M3OnGreenBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource M3SecondaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding ConnectActionText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource M3SecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource M3OnGreenBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Session Timer + External IP Chip -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Border CornerRadius="10" Background="{DynamicResource M3SurfaceContainerHighBrush}" Padding="10,4" Margin="0,0,6,0" Visibility="{Binding TimerText, Converter={StaticResource StringNotEmptyToVisibility}}">
                                        <TextBlock Text="{Binding TimerText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}"/>
                                    </Border>
                                    <Border CornerRadius="10" Background="{DynamicResource M3SurfaceContainerHighBrush}" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="CopyIp_Click" ToolTip="Нажмите, чтобы скопировать IP" Visibility="{Binding IpText, Converter={StaticResource StringNotEmptyToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGlobe}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource M3SecondaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IpText}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Live Telemetry Card (Speed | Smooth Wave | Transferred) -->
                                <Border Width="336" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="14,10" Margin="0,10,0,0" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="78"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="74"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="СКОРОСТЬ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding UploadSpeedText, StringFormat='↑ {0}'}" FontSize="10" Foreground="{DynamicResource M3SecondaryBrush}"/>
                                        </StackPanel>
                                        <controls:SpeedGraph x:Name="TrafficGraph" Grid.Column="1" Height="42" Margin="10,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="ПЕРЕДАНО" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TotalTransferredText}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            <TextBlock Text="сессия" FontSize="10" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Mode Segmented Selector -->
                        <Grid Grid.Row="3" Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Режим" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" CornerRadius="18" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ProxyModeBtn" Grid.Column="0" Style="{StaticResource M3SegmentedBtn}" IsChecked="True" Checked="ProxyMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGlobe}" Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="Proxy"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TunModeBtn" Grid.Column="1" Style="{StaticResource M3SegmentedBtn}" Checked="TunMode_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconLayers}" Width="13" Height="13" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="TUN"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom Quick Actions -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource M3FilledBtn}" Height="40" Command="{Binding AutoSelectConnectCommand}" ToolTip="Найти сервер с минимальным пингом и подключиться">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Автовыбор"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource M3TonalBtn}" Height="40" Command="{Binding ShowMassImportCommand}" ToolTip="Импортировать ссылки или буфер обмена">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconImport}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Импорт"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource M3TonalBtn}" Height="40" Command="{Binding TestServerCommand}" ToolTip="Проверить задержку выбранного сервера">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPulse}" Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Тест"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT PANEL: Servers & Subscriptions -->
                <Border Grid.Column="1" CornerRadius="28" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="10,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header + Search + Subscription Banner -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Серверы" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="10" Background="{DynamicResource M3SurfaceContainerHighBrush}" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ServerCountLabel" Text="0 серверов" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource M3CircleIconBtn}" Command="{Binding ShowSubscriptionsCommand}" ToolTip="Управление подписками" Margin="0,0,6,0">
                                        <Path Data="{StaticResource IconAdd}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource M3CircleIconBtn}" Command="{Binding UpdateSubscriptionsCommand}" ToolTip="Обновить подписки" Margin="0,0,6,0">
                                        <Path Data="{StaticResource IconRefresh}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button Style="{StaticResource M3CircleIconBtn}" Command="{Binding PingAllCommand}" ToolTip="Проверить пинг всех серверов" Margin="0,0,6,0">
                                        <Path Data="{StaticResource IconSpeed}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button x:Name="ToggleAllGroupsBtn" Style="{StaticResource M3CircleIconBtn}" Click="ToggleAllGroups_Click" ToolTip="Свернуть / развернуть все подписки" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconLayers}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>

                                    <Button Style="{StaticResource M3TonalBtn}" Height="36" Padding="11,0" Margin="0,0,5,0" Command="{Binding SortByPingCommand}" ToolTip="Сортировать по пингу">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSort}" Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0"/>
                                            <TextBlock Text="Пинг" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource M3TonalBtn}" Height="36" Padding="11,0" Command="{Binding SortByNameCommand}" ToolTip="Сортировать по имени">
                                        <TextBlock Text="А–Я" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Pill Search Input -->
                            <Border CornerRadius="20" Background="{DynamicResource M3SurfaceContainerLowBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Margin="0,12,0,0" Height="40">
                                <Grid Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SearchPlaceholder" Text="Поиск по стране, названию или протоколу..." FontSize="12.5" Foreground="{DynamicResource M3OutlineBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="ServerSearchBox" Text="" FontSize="12.5" Foreground="{DynamicResource M3OnSurfaceBrush}" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" TextChanged="ServerSearch_TextChanged">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="CaretBrush" Value="{DynamicResource M3PrimaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TextBox">
                                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                    <Button x:Name="ClearSearchBtn" Grid.Column="2" Width="24" Height="24" Visibility="Collapsed" Click="ClearSearch_Click" Style="{StaticResource M3CircleIconBtn}" BorderThickness="0" Background="Transparent" ToolTip="Очистить поиск">
                                        <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Server Cards List -->
                        <ListBox Grid.Row="1" x:Name="ServerListControl" ItemsSource="{Binding Servers}"
                                 SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                                 MouseDoubleClick="ServerListControl_MouseDoubleClick"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource M3CardList}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander x:Name="GroupExpander" IsExpanded="True" Margin="0,4,0,6"
                                                                  Loaded="GroupExpander_Loaded" Unloaded="GroupExpander_Unloaded"
                                                                  Expanded="GroupExpander_StateChanged" Collapsed="GroupExpander_StateChanged">
                                                            <Expander.Template>
                                                                <ControlTemplate TargetType="Expander">
                                                                    <StackPanel>
                                                                        <Border x:Name="hdr" CornerRadius="16" Padding="14,11"
                                                                                Background="{DynamicResource M3SurfaceContainerLowBrush}"
                                                                                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                                                                                BorderThickness="1">
                                                                            <StackPanel>
                                                                                <!-- Top Row: Expand Toggle + Meta + Per-group Actions -->
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                                  Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center">
                                                                                        <ToggleButton.Template>
                                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                                <Border Background="Transparent">
                                                                                                    <ContentPresenter/>
                                                                                                </Border>
                                                                                            </ControlTemplate>
                                                                                        </ToggleButton.Template>
                                                                                        <Grid Background="Transparent">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Path x:Name="Chevron" Grid.Column="0" Data="{StaticResource IconChevronRight}"
                                                                                                  Width="13" Height="13" Stretch="Uniform"
                                                                                                  Fill="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                                  VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                                                                <Path.Style>
                                                                                                    <Style TargetType="Path">
                                                                                                        <Setter Property="RenderTransform">
                                                                                                            <Setter.Value>
                                                                                                                <RotateTransform Angle="0"/>
                                                                                                            </Setter.Value>
                                                                                                        </Setter>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                                                <Setter Property="RenderTransform">
                                                                                                                    <Setter.Value>
                                                                                                                        <RotateTransform Angle="90"/>
                                                                                                                    </Setter.Value>
                                                                                                                </Setter>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Path.Style>
                                                                                            </Path>
                                                                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="14"
                                                                                                    Background="{DynamicResource M3PrimaryContainerBrush}"
                                                                                                    BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1"
                                                                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                                                                <Path Data="{StaticResource IconRss}" Width="12" Height="12" Stretch="Uniform"
                                                                                                      Fill="{DynamicResource M3PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <TextBlock x:Name="SubIntervalText" Text="" FontSize="10.5"
                                                                                                           Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                                           Visibility="Collapsed" Margin="0,1,0,0"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </ToggleButton>

                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock x:Name="SubUpdatedText" Text="" FontSize="10.5" FontFamily="Consolas"
                                                                                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                                   VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                                                                                        <Border CornerRadius="8" Background="{DynamicResource M3PrimaryContainerBrush}"
                                                                                                Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="Bold"
                                                                                                       Foreground="{DynamicResource M3PrimaryBrush}"/>
                                                                                        </Border>
                                                                                        <Button x:Name="GroupRefreshBtn" Width="30" Height="30" Style="{StaticResource M3CircleIconBtn}"
                                                                                                Click="RefreshGroup_Click" ToolTip="Обновить эту подписку" Margin="0,0,5,0">
                                                                                            <Path Data="{StaticResource IconRefresh}" Width="13" Height="13" Stretch="Uniform"
                                                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                                        </Button>
                                                                                        <Button x:Name="GroupPingBtn" Width="30" Height="30" Style="{StaticResource M3CircleIconBtn}"
                                                                                                Click="PingGroup_Click" ToolTip="Проверить пинг серверов подписки" Margin="0,0,5,0">
                                                                                            <Path Data="{StaticResource IconSpeed}" Width="14" Height="14" Stretch="Uniform"
                                                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                                        </Button>
                                                                                        <Button x:Name="GroupMoreBtn" Width="30" Height="30" Style="{StaticResource M3CircleIconBtn}"
                                                                                                Click="MoreGroup_Click" ToolTip="Меню подписки">
                                                                                            <Path Data="{StaticResource IconMoreHoriz}" Width="14" Height="14" Stretch="Uniform"
                                                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                                        </Button>
                                                                                    </StackPanel>
                                                                                </Grid>

                                                                                <!-- Middle Row: Remaining Days + Progress Bar + Traffic -->
                                                                                <Grid x:Name="SubMetaRow" Margin="0,10,0,0" Visibility="Collapsed">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock x:Name="SubExpireText" Grid.Column="0" Text="" FontSize="11.5"
                                                                                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                                    <ProgressBar x:Name="SubProgressBar" Grid.Column="1" Height="5" Minimum="0" Maximum="1" Value="0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Background="{DynamicResource M3SurfaceContainerHighestBrush}"
                                                                                                 Foreground="{DynamicResource M3PrimaryBrush}" BorderThickness="0">
                                                                                        <ProgressBar.Template>
                                                                                            <ControlTemplate TargetType="ProgressBar">
                                                                                                <Grid x:Name="TemplateRoot">
                                                                                                    <Border x:Name="PART_Track" CornerRadius="2.5" Background="{TemplateBinding Background}"/>
                                                                                                    <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                                                                                        <Border CornerRadius="2.5" Background="{TemplateBinding Foreground}"/>
                                                                                                    </Decorator>
                                                                                                </Grid>
                                                                                            </ControlTemplate>
                                                                                        </ProgressBar.Template>
                                                                                    </ProgressBar>
                                                                                    <TextBlock x:Name="SubTrafficText" Grid.Column="2" Text="" FontSize="11.5" FontFamily="Consolas"
                                                                                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                                                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                                </Grid>

                                                                                <!-- Bottom Row: Support / Website Pills -->
                                                                                <StackPanel x:Name="SubLinksRow" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                                                                    <Button x:Name="SubSupportBtn" Style="{StaticResource M3TonalBtn}" Height="28" Padding="10,0"
                                                                                            Margin="0,0,6,0" Click="OpenGroupSupport_Click" Visibility="Collapsed"
                                                                                            Background="{DynamicResource M3GreenContainerBrush}" Foreground="{DynamicResource M3GreenBrush}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                                                                                                  Fill="{DynamicResource M3GreenBrush}" Margin="0,0,6,0"/>
                                                                                            <TextBlock Text="Поддержка" FontSize="11.5" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button x:Name="SubWebBtn" Style="{StaticResource M3TonalBtn}" Height="28" Padding="10,0"
                                                                                            Click="OpenGroupWeb_Click" Visibility="Collapsed">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <Path Data="{StaticResource IconGlobe}" Width="12" Height="12" Stretch="Uniform"
                                                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/>
                                                                                            <TextBlock Text="Сайт" FontSize="11.5" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,6,0,0"/>
                                                                    </StackPanel>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsExpanded" Value="True">
                                                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                                        </Trigger>
                                                                        <Trigger SourceName="hdr" Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="hdr" Property="Background" Value="{DynamicResource M3SurfaceContainerBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Expander.Template>
                                                            <ItemsPresenter/>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Style="{StaticResource M3ScrollViewer}" Focusable="False" Padding="0,0,4,0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu Background="{DynamicResource M3SurfaceContainerBrush}" Foreground="{DynamicResource M3OnSurfaceBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1">
                                                <MenuItem Header="Подключиться" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ConnectToServerCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Копировать URI" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CopyServerUriCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Проверить пинг" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.TestServerCommand}" CommandParameter="{Binding}"/>
                                                <Separator Background="{DynamicResource M3OutlineVariantBrush}"/>
                                                <MenuItem Header="Удалить" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DeleteServerCommand}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Country Flag Badge -->
                                        <Border Grid.Column="0" CornerRadius="10" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" Width="44" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="RowFlagImage" Source="{Binding CountryBadge, Converter={StaticResource CountryFlag}}" Width="36" Height="24" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CountryBadge}" Value="GL">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Path Data="{StaticResource IconGlobe}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource M3OnSurfaceVariantBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CountryBadge}" Value="GL">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Source, ElementName=RowFlagImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Border>

                                        <!-- Server Title + Chips + Location -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border CornerRadius="6" Padding="6,2" Background="{Binding Protocol, Converter={StaticResource ProtocolToBadgeColor}}" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Protocol}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Protocol, Converter={StaticResource ProtocolToBadgeForeground}}"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="6,2" Background="{Binding Transport, Converter={StaticResource ProtocolToBadgeColor}}" Margin="0,0,4,0" Visibility="{Binding Transport, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                    <TextBlock Text="{Binding Transport}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Transport, Converter={StaticResource ProtocolToBadgeForeground}}"/>
                                                </Border>
                                                <Border CornerRadius="6" Padding="6,2" Background="{Binding Security, Converter={StaticResource ProtocolToBadgeColor}}" Margin="0,0,6,0" Visibility="{Binding Security, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                    <TextBlock Text="{Binding Security}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Security, Converter={StaticResource ProtocolToBadgeForeground}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LocationSummary}" FontSize="10.5" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Ping Pill -->
                                        <Border Grid.Column="2" CornerRadius="11" Background="{Binding Ping, Converter={StaticResource PingToBackground}}" Padding="10,6" VerticalAlignment="Center">
                                            <controls:PingBadge PingValue="{Binding Ping}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- M3 Expressive Settings Overlay -->
            <Border x:Name="SettingsOverlay" Visibility="Collapsed" Background="{DynamicResource M3SurfaceDimBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1">
                        <Grid MaxWidth="740" Margin="16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="SettingsBackBtn" Width="34" Height="34" Style="{StaticResource M3CircleIconBtn}" Click="SettingsBack_Click" ToolTip="Назад" Margin="0,0,12,0">
                                    <Path Data="{StaticResource IconArrowLeft}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                                <TextBlock x:Name="SettingsTitleText" Text="Настройки" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ContentControl x:Name="SettingsContent" Grid.Row="1" MaxWidth="740" HorizontalAlignment="Stretch" Margin="16,10,16,16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
